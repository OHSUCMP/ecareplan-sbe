{{>layout/header}}

<div id="sessionEstablished" class="hidden">{{sessionEstablished}}</div>
<div id="dataSets" class="hidden">{{dataSets}}</div>

<div class="container">
    {{#systemStatusMessage}}
        <div class="row align-items-center alert alert-teal" role="alert">
            <div class="col-md-auto text-center">
                <img src="/images/info-icon.png" alt="System Status" height="50px" />
            </div>
            <div class="col">
                {{systemStatusMessage}}
            </div>
        </div>
    {{/systemStatusMessage}}

    <div id="progressContainer" class="hidden"></div>

    <h1>Medications</h1>
    <div class="modelsContainer">
        Loading...
    </div>

    <div class="cardContainer">
        {{#medicationModels}}
            <div class="card">
                <table>
                    <thead>
                    <tr>
                        <td colspan="2">{{conceptName}}</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td colspan="2">
                            {{#flags}}
                                <div class="flag" style="background-color: {{backgroundColor}}; color: {{textColor}}; border: 1px solid black;">
                                    {{label}}
                                </div>
                            {{/flags}}
                        </td>
                    </tr>
                    <tr>
                        <td>{{#category}}Category: {{category}}{{/category}}</td>
                        <td>Status: {{status}}</td>
                    </tr>
                    <tr>
                        <td>Ordered On: {{#authoredOn}}{{authoredOn}}{{/authoredOn}}</td>
                        <td>By: {{#requester}}{{requester}}{{/requester}}</td>
                    </tr>
                    {{#dosageInstructions}}
                        <tr>
                            <td colspan="2">{{dosageInstruction}}</td>
                        </tr>
                    {{/dosageInstructions}}
                    {{#reasons}}
                        <tr>
                            <td colspan="2">Reason: {{.}}</td>
                        </tr>
                    {{/reasons}}
                    {{#notes}}
                        <tr>
                            <td colspan="2">Note: {{.}}</td>
                        </tr>
                    {{/notes}}
                    <tr>
                        <td colspan="2">Source: {{sourceEndpointName}}</td>
                    </tr>
                    </tbody>
                </table>
            </div>
        {{/medicationModels}}
    </div>
</div>

<script type="text/javascript">
    function getBasePath() {
        return "/patient/medications";
    }

    function renderModels(models) {
        let container = $('#modelsContainer');
        if (models && models.length > 0) {
            let cards = [];
            let id = 1;
            models.forEach(function(model) {
                cards.push(renderCard('card_' + id, buildCardData(model)));
                id ++;
            });
            container.html(cards.join('\n'));
        }
    }

    function buildCardData(model) {
        return {
            title: model.conceptName,
            rows: [],
            history: null
        };
    }

    $(document).ready(function() {
        if ($('#sessionEstablished').text() !== 'true') {
            return;
        }

        // on page load, get the list of models before SSE triggers
        getUpdatedModels(renderModels);
        initializeSSE();
    });
</script>

{{>layout/footer}}