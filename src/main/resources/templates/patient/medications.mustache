{{>layout/header}}

<div id="sessionEstablished" class="hidden">{{sessionEstablished}}</div>

<div class="container">
    {{#systemStatusMessage}}
        <div class="row align-items-center alert alert-teal" role="alert">
            <div class="col-md-auto text-center">
                <img src="/images/info-icon.png" alt="System Status" height="50px" />
            </div>
            <div class="col">
                {{systemStatusMessage}}
            </div>
        </div>
    {{/systemStatusMessage}}

    <h1>Medications</h1>
    <div class="cardContainer">
        {{#medicationModels}}
            <div class="card">
                <table>
                    <thead>
                    <tr>
                        <td colspan="2">{{conceptName}}</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td>{{#category}}Category: {{category}}{{/category}}</td>
                        <td>Status: {{status}}</td>
                    </tr>
                    <tr>
                        <td>Ordered On: {{#authoredOn}}{{authoredOn}}{{/authoredOn}}</td>
                        <td>By: {{#requester}}{{requester}}{{/requester}}</td>
                    </tr>
                    {{#dosageInstructions}}
                        <tr>
                            <td colspan="2">{{dosageInstruction}}</td>
                        </tr>
                    {{/dosageInstructions}}
                    {{#reasons}}
                        <tr>
                            <td colspan="2">Reason: {{.}}</td>
                        </tr>
                    {{/reasons}}
                    {{#notes}}
                        <tr>
                            <td colspan="2">Note: {{.}}</td>
                        </tr>
                    {{/notes}}
                    <tr>
                        <td colspan="2">Source: {{sourceEndpointName}}</td>
                    </tr>
                    </tbody>
                </table>
            </div>
        {{/medicationModels}}
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function() {
        let sessionEstablished = $('#sessionEstablished').text();
        if (sessionEstablished !== 'true') {
            return;
        }

        // todo : things that should happen once the page has loaded
    });
</script>

{{>layout/footer}}