{{>layout/header}}

<div id="sessionEstablished" class="hidden">{{sessionEstablished}}</div>
<div id="dataSets" class="hidden">{{dataSets}}</div>

<div class="container">
    {{>fragments/system-status-message}}

    <div id="progressContainer" class="hidden"></div>

    <h1>Medications</h1>
    <div id="modelsContainer">
        <div class="d-flex align-items-center gap-3 p-3 border rounded bg-light text-muted" role="status" aria-live="polite">
            <div class="spinner-border color-primary" aria-hidden="true"></div>
            <div>
                <div class="fw-semibold">Loading records...</div>
                <div class="small">We’re gathering the latest information for this section.</div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function getBasePath() {
        return "/patient/medications";
    }

    function buildCardSelectorData(model) {
        model = model || {};

        let flags = Array.isArray(model.flags) ? model.flags : [];

        return [{
            label: 'Name',
            value: model.conceptName || '(No Name)',
            bootstrapWidth: 5
        }, {
            label: 'Flag',
            value: flags.length > 0 ? renderFlags(flags) : '',
            bootstrapWidth: 4
        }, {
            label: 'Ordered On',
            value: formatDate(model.authoredOn),
            valueForCompare: model.authoredOn,
            bootstrapWidth: 3
        }];
    }

    function buildCardData(model) {
        model = model || {};

        let card = {};
        let flags = Array.isArray(model.flags) ? model.flags : [];
        let reasons = Array.isArray(model.reasons) ? model.reasons : [];
        let notes = Array.isArray(model.notes) ? model.notes : [];

        card.title = model.conceptName || '(No Name)';
        card.source = model.sourceEndpointName;
        card.rows = [];

        if (flags.length > 0) {
            card.rows.push([{ label: 'Flags', value: renderFlags(flags) }]);
        }
        if (model.category || model.status) {
            card.rows.push([
                { label: 'Category', value: model.category || '' },
                { label: 'Status', value: model.status || '' }
            ]);
        }
        if (model.authoredOn || model.requester) {
            card.rows.push([
                { label: 'Ordered On', value: formatDate(model.authoredOn) },
                { label: 'Requested By', value: model.requester || '' }
            ]);
        }
        if (model.dosageInstruction) {
            card.rows.push([{ label: 'Dosage Instruction', value: model.dosageInstruction }]);
        }
        if (reasons.length > 0) {
            card.rows.push({
                title: 'Reasons',
                headers: [ 'Reason' ],
                rows: reasons.map(function(reason) {
                    return [ reason || '' ];
                }),
                beginExpanded: true
            });
        }
        if (notes.length > 0) {
            card.rows.push({
                title: 'Notes',
                headers: [ 'Note' ],
                rows: notes.map(function(note) {
                    return [ note || '' ];
                }),
                beginExpanded: true
            });
        }

        return card;
    }

    function renderFlags(flags) {
        if (!Array.isArray(flags) || flags.length === 0) return '';

        return flags.map(function(flag) {
            flag = flag || {};

            return '<span class="flag" style="background-color: ' + escapeHtml(flag.backgroundColor || '#ffffff') +
                    '; color: ' + escapeHtml(flag.textColor || '#000000') + ';">' +
                    escapeHtml(flag.label || '') +
                    '</span>';
        }).join(' ');
    }

    $(document).ready(function() {
        try {
            if ($('#sessionEstablished').text() !== 'true') {
                return;
            }

            getUpdatedModels(renderModels);
            initializeSSE(renderModels);
        } catch (error) {
            reportAndRenderModelsError(error, getBasePath() + ' document ready');
        }
    });
</script>

{{>layout/footer}}