{{>layout/header}}

<div id="sessionEstablished" class="hidden">{{sessionEstablished}}</div>
<div id="dataSets" class="hidden">{{dataSets}}</div>

<div class="container">
    {{>fragments/system-status-message}}

    <div id="progressContainer" class="hidden"></div>

    <h1>Health Goals</h1>
    <div id="modelsContainer">
        <div class="d-flex align-items-center gap-3 p-3 border rounded bg-light text-muted" role="status" aria-live="polite">
            <div class="spinner-border color-primary" aria-hidden="true"></div>
            <div>
                <div class="fw-semibold">Loading records...</div>
                <div class="small">We’re gathering the latest information for this section.</div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function getBasePath() {
        return "/patient/health-goals";
    }

    function buildCardSelectorData(model) {
        return [{
            label: 'Description',
            value: model.description,
            bootstrapWidth: 5
        }, {
            label: 'Start Date',
            value: formatDate(model.startDate),
            valueForCompare: model.startDate,
            bootstrapWidth: 4
        }, {
            label: 'Status',
            value: model.consolidatedStatus,
            bootstrapWidth: 3
        }];
    }

    function buildCardData(model) {
        let card = {};
        card.title = model.description ?? '(No Description)';
        card.rows = [];
        if (model.expressedBy || model.startDate) {
            card.rows.push([
                { label: 'Expressed By', value: model.expressedBy },
                { label: 'Start Date', value: formatDate(model.startDate) }
            ]);
        }
        if (model.consolidatedStatus) {
            card.rows.push([{ label: 'Status', value: model.consolidatedStatus }]);
        }
        if (model.notes && model.notes.length > 0) {
            card.rows.push({
                title: 'Notes',
                headers: [ 'Note' ],
                rows: model.notes.map(function(note) {
                    return [ note ];
                }),
                beginExpanded: true
            });
        }
        card.rows.push([{ label: 'Source', value: model.sourceEndpointName }]);
        return card;
    }

    $(document).ready(function() {
        if ($('#sessionEstablished').text() !== 'true') {
            return;
        }

        // on page load, get the list of models before SSE triggers
        getUpdatedModels(renderModels);
        initializeSSE(renderModels);
    });
</script>

{{>layout/footer}}