{{>layout/header}}

<div id="sessionEstablished" class="hidden">{{sessionEstablished}}</div>
<div id="dataSets" class="hidden">{{dataSets}}</div>

<div class="container">
    {{>fragments/system-status-message}}

    <div id="progressContainer" class="hidden"></div>

    <h1>Health Concerns</h1>
    <div id="modelsContainer">
        <div class="d-flex align-items-center gap-3 p-3 border rounded bg-light text-muted" role="status" aria-live="polite">
            <div class="spinner-border color-primary" aria-hidden="true"></div>
            <div>
                <div class="fw-semibold">Loading records...</div>
                <div class="small">We’re gathering the latest information for this section.</div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function getBasePath() {
        return "/patient/health-concerns";
    }

    function buildCardSelectorData(model) {
        return [{
            label: 'Name',
            value: model.name,
            bootstrapWidth: 7
        }, {
            label: 'Effective Date',
            value: formatDate(model.onsetDate || model.recordedDate),
            valueForCompare: model.onsetDate || model.recordedDate,
            bootstrapWidth: 5
        }];
    }

    function buildCardData(model) {
        let card = {};
        card.title = model.name;
        card.source = model.sourceEndpointName;
        card.rows = [];
        if (model.asserter) {
            card.rows.push([{ label: 'Asserted By', value: model.asserter }]);
        }
        if (model.recorder) {
            card.rows.push([{ label: 'Recorded By', value: model.recorder }]);
        }
        if (model.recordedDate) {
            card.rows.push([{ label: 'Recorded On', value: formatDate(model.recordedDate) }]);
        }
        if (model.onsetDate) {
            card.rows.push([{ label: 'Onset Date', value: formatDate(model.onsetDate) }]);
        }
        if (model.notes && model.notes.length > 0) {
            card.rows.push({
                title: 'Notes',
                headers: [ 'Note' ],
                rows: model.notes.map(function(note) {
                    return [ note ];
                }),
                beginExpanded: true
            });
        }
        return card;
    }

    $(document).ready(function() {
        if ($('#sessionEstablished').text() !== 'true') {
            return;
        }

        // on page load, get the list of models before SSE triggers
        getUpdatedModels(renderModels);
        initializeSSE(renderModels);
    });
</script>

{{>layout/footer}}