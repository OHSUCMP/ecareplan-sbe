{{>layout/header}}

<div id="sessionEstablished" class="hidden">{{sessionEstablished}}</div>
<div id="dataSets" class="hidden">{{dataSets}}</div>

<div class="container">
    {{#systemStatusMessage}}
        <div class="row align-items-center alert alert-teal" role="alert">
            <div class="col-md-auto text-center">
                <img src="/images/info-icon.png" alt="System Status" height="50px" />
            </div>
            <div class="col">
                {{systemStatusMessage}}
            </div>
        </div>
    {{/systemStatusMessage}}

    <div id="progressContainer" class="hidden"></div>

    <h1>Current Health Issues</h1>
    <p>
        <input type="button" value="Add a Health Concern" onclick="window.location.href='/patient/conditions/add'" />
    </p>

    <div id="modelsContainer">
        Loading...
    </div>

    <div class="cardContainer">
        {{#conditionModels}}
            <div class="card">
                <table>
                    <thead>
                    <tr>
                        <td colspan="2">{{name}}</td>
                    </tr>
                    </thead>
                    <tbody>
                    {{#asserter}}
                        <tr>
                            <td colspan="2">Asserted by: {{asserter}}</td>
                        </tr>
                    {{/asserter}}
                    {{#recorder}}
                        <tr>
                            <td colspan="2">Recorded by: {{recorder}}</td>
                        </tr>
                    {{/recorder}}
                    {{#recordedDate}}
                        <tr>
                            <td colspan="2">Recorded on: {{recordedDate}}</td>
                        </tr>
                    {{/recordedDate}}
                    {{#onsetDate}}
                        <tr>
                            <td colspan="2">When it started: {{onsetDate}}</td>
                        </tr>
                    {{/onsetDate}}
                    {{#notes}}
                        <tr>
                            <td colspan="2">Note: {{.}}</td>
                        </tr>
                    {{/notes}}
                    <tr>
                        <td colspan="2">Source: {{sourceEndpointName}}</td>
                    </tr>
                    </tbody>
                </table>
            </div>
        {{/conditionModels}}
    </div>
</div>

<script type="text/javascript">
    function getBasePath() {
        return "/patient/health-concerns";
    }

    function renderModels(models) {
        let container = $('#modelsContainer');
        if (models && models.length > 0) {
            let cards = [];
            let id = 1;
            models.forEach(function(model) {
                cards.push(renderCard('card_' + id, buildCardData(model)));
                id ++;
            });
            container.html(cards.join('\n'));
        }
    }

    function buildCardData(model) {
        return {
            title: model.name,
            rows: [],
            history: null
        };
    }

    $(document).ready(function() {
        if ($('#sessionEstablished').text() !== 'true') {
            return;
        }

        // on page load, get the list of models before SSE triggers
        getUpdatedModels(renderModels);
        initializeSSE();
    });
</script>

{{>layout/footer}}