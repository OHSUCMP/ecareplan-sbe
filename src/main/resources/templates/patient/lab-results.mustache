{{>layout/header}}

<div id="sessionEstablished" class="hidden">{{sessionEstablished}}</div>

<div class="container">
    {{#systemStatusMessage}}
        <div class="row align-items-center alert alert-teal" role="alert">
            <div class="col-md-auto text-center">
                <img src="/images/info-icon.png" alt="System Status" height="50px" />
            </div>
            <div class="col">
                {{systemStatusMessage}}
            </div>
        </div>
    {{/systemStatusMessage}}

    <h1>Lab Results</h1>
    <div class="cardContainer">
        {{#labResultModels}}
            <div class="card">
                <table>
                    <thead>
                    <tr>
                        <td colspan="2">{{description}}</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td>{{#resultText}}{{resultText}}{{/resultText}}</td>
                        <td>{{#effectiveDate}}{{effectiveDate}}{{/effectiveDate}}</td>
                    </tr>
                    {{#referenceRange}}
                        <tr>
                            <td colspan="2">{{referenceRange}}</td>
                        </tr>
                    {{/referenceRange}}
                    {{#notes}}
                        <tr>
                            <td colspan="2">Note: {{.}}</td>
                        </tr>
                    {{/notes}}
                    <tr>
                        <td colspan="2">Source: {{sourceEndpointName}}</td>
                    </tr>
                    </tbody>
                </table>
            </div>
        {{/labResultModels}}
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function() {
        let sessionEstablished = $('#sessionEstablished').text();
        if (sessionEstablished !== 'true') {
            return;
        }

        // todo : things that should happen once the home page is loaded
    });
</script>

{{>layout/footer}}