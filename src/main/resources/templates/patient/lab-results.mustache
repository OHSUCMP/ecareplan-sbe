{{>layout/header}}

<div id="sessionEstablished" class="hidden">{{sessionEstablished}}</div>
<div id="dataSets" class="hidden">{{dataSets}}</div>

<div class="container">
    {{#systemStatusMessage}}
        <div class="row align-items-center alert alert-teal" role="alert">
            <div class="col-md-auto text-center">
                <img src="/images/info-icon.png" alt="System Status" height="50px" />
            </div>
            <div class="col">
                {{systemStatusMessage}}
            </div>
        </div>
    {{/systemStatusMessage}}

    <div id="progressContainer" class="hidden"></div>

    <h1>Lab Results</h1>
    <div id="modelsContainer">
        <div class="d-flex align-items-center gap-3 p-3 border rounded bg-light text-muted" role="status" aria-live="polite">
            <div class="spinner-border color-primary" aria-hidden="true"></div>
            <div>
                <div class="fw-semibold">Loading records...</div>
                <div class="small">We’re gathering the latest information for this section.</div>
            </div>
        </div>
    </div>

    <div class="cardContainer">
        {{#labResultModels}}
            <div class="card">
                <table>
                    {{#mostRecentData}}
                        <thead>
                        <tr>
                            <td colspan="2">{{description}}</td>
                        </tr>
                        </thead>
                    <tbody>
                    <tr>
                        <td>{{#resultText}}{{resultText}}{{/resultText}}</td>
                        <td>{{#effectiveDate}}{{effectiveDate}}{{/effectiveDate}}</td>
                    </tr>
                    {{#referenceRange}}
                    <tr>
                        <td colspan="2">{{referenceRange}}</td>
                    </tr>
                    {{/referenceRange}}
                    {{#notes}}
                    <tr>
                        <td colspan="2">Note: {{.}}</td>
                    </tr>
                    {{/notes}}
                    <tr>
                        <td colspan="2">Source: {{sourceEndpointName}}</td>
                    </tr>
                    {{/mostRecentData}}
                    {{#historicalData}}
                        <tr>
                            <td>{{#resultText}}{{resultText}}{{/resultText}}</td>
                            <td>{{#effectiveDate}}{{effectiveDate}}{{/effectiveDate}}</td>
                        </tr>
                    {{/historicalData}}
                    </tbody>
                </table>
            </div>
        {{/labResultModels}}
    </div>
</div>

<script type="text/javascript">
    function getBasePath() {
        return "/patient/lab-results";
    }

    function buildCardSelectorData(model) {
        return [{
            label: 'Description',
            value: model.mostRecentData.description,
            bootstrapWidth: 8
        }, {
            label: 'Source',
            value: model.mostRecentData.sourceEndpointName,
            bootstrapWidth: 4
        }];
    }

    function buildCardData(model) {
        let card = {};
        card.title = model.mostRecentData.description;
        card.chart = buildConsolidatedChartData(model);

        card.rows = [];
        card.rows.push([ model.mostRecentData.resultText ?? '(No Result)', formatDate(model.mostRecentData.effectiveDate) ?? '(No Date)' ]);
        if (model.mostRecentData.performers) {
            model.mostRecentData.performers.forEach(function(performer) {
                card.rows.push([ 'Performed by: ' + performer ]);
            });
        }
        if (model.mostRecentData.referenceRange) {
            card.rows.push([ model.mostRecentData.referenceRange ]);
        }
        if (model.mostRecentData.notes && model.mostRecentData.notes.length > 0) {
            card.rows.push({
                title: 'Notes',
                headers: [ 'Note' ],
                rows: model.mostRecentData.notes.map(function(note) {
                    return [ note ];
                })
            });
        }
        card.rows.push([ 'Source: ' + model.mostRecentData.sourceEndpointName ]);

        if (model.historicalData && model.historicalData.length > 0) {
            card.rows.push({
                title: 'Historical Data',
                headers: [ 'Result', 'Effective Date' ],
                rows: model.historicalData.map(function(data) {
                    return [ data.resultText ?? '(No Result)', formatDate(data.effectiveDate) ?? '(No Date)' ];
                })
            });
        }

        return card;
    }

    $(document).ready(function() {
        if ($('#sessionEstablished').text() !== 'true') {
            return;
        }

        // on page load, get the list of models before SSE triggers
        getUpdatedModels(renderModels);
        initializeSSE(renderModels);
    });
</script>

{{>layout/footer}}