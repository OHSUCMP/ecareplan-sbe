{{>layout/header}}

<div id="sessionEstablished" class="hidden">{{sessionEstablished}}</div>
<div id="dataSets" class="hidden">{{dataSets}}</div>

<div class="container">
    {{>fragments/system-status-message}}

    <div id="progressContainer" class="hidden"></div>

    <h1>Lab Results</h1>
    <div id="modelsContainer">
        <div class="d-flex align-items-center gap-3 p-3 border rounded bg-light text-muted" role="status" aria-live="polite">
            <div class="spinner-border color-primary" aria-hidden="true"></div>
            <div>
                <div class="fw-semibold">Loading records...</div>
                <div class="small">We’re gathering the latest information for this section.</div>
            </div>
        </div>
    </div>

    <div class="cardContainer">
        {{#labResultModels}}
            <div class="card">
                <table>
                    {{#mostRecentData}}
                        <thead>
                        <tr>
                            <td colspan="2">{{description}}</td>
                        </tr>
                        </thead>
                    <tbody>
                    <tr>
                        <td>{{#resultText}}{{resultText}}{{/resultText}}</td>
                        <td>{{#effectiveDate}}{{effectiveDate}}{{/effectiveDate}}</td>
                    </tr>
                    {{#referenceRange}}
                    <tr>
                        <td colspan="2">{{referenceRange}}</td>
                    </tr>
                    {{/referenceRange}}
                    {{#notes}}
                    <tr>
                        <td colspan="2">Note: {{.}}</td>
                    </tr>
                    {{/notes}}
                    <tr>
                        <td colspan="2">Source: {{sourceEndpointName}}</td>
                    </tr>
                    {{/mostRecentData}}
                    {{#historicalData}}
                        <tr>
                            <td>{{#resultText}}{{resultText}}{{/resultText}}</td>
                            <td>{{#effectiveDate}}{{effectiveDate}}{{/effectiveDate}}</td>
                        </tr>
                    {{/historicalData}}
                    </tbody>
                </table>
            </div>
        {{/labResultModels}}
    </div>
</div>

<script type="text/javascript">
    function getBasePath() {
        return "/patient/lab-results";
    }

    function buildCardSelectorData(model) {
        let mostRecentData = getVisibleSourceRecords(model, 'effectiveDate')[0] || {};

        return [{
            label: 'Description',
            value: mostRecentData.description || '(No Description)',
            bootstrapWidth: 8
        }, {
            label: 'Effective Date',
            value: formatDate(mostRecentData.effectiveDate),
            valueForCompare: mostRecentData.effectiveDate,
            bootstrapWidth: 4
        }];
    }

    function buildCardData(model) {
        let records = getVisibleSourceRecords(model, 'effectiveDate');
        let mostRecentData = records[0] || {};
        let historicalData = records.slice(1);

        let card = {};
        card.title = mostRecentData.description || '(No Description)';

        card.source = getSourceEndpointNames(records.map(function(record) {
            return record.sourceEndpointName;
        }));

        card.chart = buildConsolidatedChartData(records);

        card.rows = [];
        card.rows.push([
            { label: 'Result', value: mostRecentData.resultText || '(No Result)' },
            { label: 'Effective Date', value: formatDate(mostRecentData.effectiveDate) || '(No Date)' }
        ]);

        let performers = Array.isArray(mostRecentData.performers) ? mostRecentData.performers : [];
        if (performers.length > 0) {
            card.rows.push({
                title: 'Performers',
                headers: [ 'Performer' ],
                rows: performers.map(function(performer) {
                    return [ performer || '' ];
                }),
                beginExpanded: true
            });
        }

        if (mostRecentData.referenceRange) {
            card.rows.push([ mostRecentData.referenceRange ]);
        }

        let notes = Array.isArray(mostRecentData.notes) ? mostRecentData.notes : [];
        if (notes.length > 0) {
            card.rows.push({
                title: 'Notes',
                headers: [ 'Note' ],
                rows: notes.map(function(note) {
                    return [ note || '' ];
                }),
                beginExpanded: true
            });
        }

        if (historicalData.length > 0) {
            card.rows.push({
                title: 'Historical Data',
                headers: [ 'Result', 'Effective Date' ],
                rows: historicalData.map(function(data) {
                    data = data || {};

                    return {
                        source: data.sourceEndpointName,
                        data: [ data.resultText || '(No Result)', formatDate(data.effectiveDate) || '(No Date)' ]
                    };
                }),
                beginExpanded: false
            });
        }

        return card;
    }

    $(document).ready(function() {
        try {
            if ($('#sessionEstablished').text() !== 'true') {
                return;
            }

            getUpdatedModels(renderModels);
            initializeSSE(renderModels);
        } catch (error) {
            reportAndRenderModelsError(error, getBasePath() + ' document ready');
        }
    });
</script>

{{>layout/footer}}