{{>layout/header}}

<div id="sessionEstablished" class="hidden">{{sessionEstablished}}</div>

<div class="container">
    {{#systemStatusMessage}}
        <div class="row align-items-center alert alert-teal" role="alert">
            <div class="col-md-auto text-center">
                <img src="/images/info-icon.png" alt="System Status" height="50px" />
            </div>
            <div class="col">
                {{systemStatusMessage}}
            </div>
        </div>
    {{/systemStatusMessage}}

    <h1>Health Goals</h1>
    <p>
        <input type="button" value="Add a New Goal" onclick="window.location.href='/patient/goals/add'" />
    </p>

    <h2>Personal Health Goals</h2>
    <div class="cardContainer">
        {{#personalHealthGoalModels}}
            <div class="card">
                <table>
                    <thead>
                    <tr>
                        <td colspan="2">{{description}}</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td>{{#expressedBy}}{{expressedBy}}{{/expressedBy}}</td>
                        <td>Start: {{startDate}}</td>
                    </tr>
                    {{#consolidatedStatus}}
                        <tr>
                            <td colspan="2">Status: {{consolidatedStatus}}</td>
                        </tr>
                    {{/consolidatedStatus}}
                    {{#firstNote}}
                        <tr>
                            <td colspan="2">Note: {{firstNote}}</td>
                        </tr>
                    {{/firstNote}}
                    <tr>
                        <td colspan="2">Source: {{sourceEndpointName}}</td>
                    </tr>
                    </tbody>
                </table>
            </div>
        {{/personalHealthGoalModels}}
    </div>

    <h2>Goals Affiliated with a Recent Hospitalization</h2>
    <div class="cardContainer">
        {{#hospitalizationGoalModels}}
            <div class="card">
                <table>
                    <thead>
                    <tr>
                        <td colspan="2">{{description}}</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td>{{#expressedBy}}{{expressedBy}}{{/expressedBy}}</td>
                        <td>Start: {{startDate}}</td>
                    </tr>
                    {{#consolidatedStatus}}
                        <tr>
                            <td colspan="2">Status: {{consolidatedStatus}}</td>
                        </tr>
                    {{/consolidatedStatus}}
                    {{#firstNote}}
                        <tr>
                            <td colspan="2">Note: {{firstNote}}</td>
                        </tr>
                    {{/firstNote}}
                    <tr>
                        <td colspan="2">Source: {{sourceEndpointName}}</td>
                    </tr>
                    </tbody>
                </table>
            </div>
        {{/hospitalizationGoalModels}}
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function() {
        let sessionEstablished = $('#sessionEstablished').text();
        if (sessionEstablished !== 'true') {
            return;
        }

        // todo : things that should happen once the home page is loaded
    });
</script>

{{>layout/footer}}