{{>layout/header}}

<div id="sessionEstablished" class="hidden">{{sessionEstablished}}</div>
<div id="dataSets" class="hidden">{{dataSets}}</div>

<div class="container">
    {{#systemStatusMessage}}
        <div class="row align-items-center alert alert-teal" role="alert">
            <div class="col-md-auto text-center">
                <img src="/images/info-icon.png" alt="System Status" height="50px" />
            </div>
            <div class="col">
                {{systemStatusMessage}}
            </div>
        </div>
    {{/systemStatusMessage}}

    <div id="progressContainer" class="hidden"></div>

    <h1>Health Goals</h1>
    <p>
        <input type="button" value="Add a New Goal" onclick="window.location.href='/patient/goals/add'" />
    </p>

    <h2>Personal Health Goals</h2>
    <div id="personalHealthModelsContainer">
        Loading...
    </div>

    <div class="cardContainer">
        {{#personalHealthGoalModels}}
            <div class="card">
                <table>
                    <thead>
                    <tr>
                        <td colspan="2">{{description}}</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td>{{#expressedBy}}{{expressedBy}}{{/expressedBy}}</td>
                        {{#startDate}}
                            <td>Start: {{startDate}}</td>
                        {{/startDate}}
                    </tr>
                    {{#consolidatedStatus}}
                        <tr>
                            <td colspan="2">Status: {{consolidatedStatus}}</td>
                        </tr>
                    {{/consolidatedStatus}}
                    {{#notes}}
                        <tr>
                            <td colspan="2">Note: {{.}}</td>
                        </tr>
                    {{/notes}}
                    <tr>
                        <td colspan="2">Source: {{sourceEndpointName}}</td>
                    </tr>
                    </tbody>
                </table>
            </div>
        {{/personalHealthGoalModels}}
    </div>

    <h2>Goals Affiliated with a Recent Hospitalization</h2>
    <div id="hospitalizationModelsContainer">
        Loading...
    </div>

    <div class="cardContainer">
        {{#hospitalizationGoalModels}}
            <div class="card">
                <table>
                    <thead>
                    <tr>
                        <td colspan="2">{{#description}}{{description}}{{/description}}{{^description}}(No Description){{/description}}</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td>{{#expressedBy}}{{expressedBy}}{{/expressedBy}}</td>
                        <td>{{#startDate}}Start: {{startDate}}{{/startDate}}</td>
                    </tr>
                    {{#consolidatedStatus}}
                        <tr>
                            <td colspan="2">Status: {{consolidatedStatus}}</td>
                        </tr>
                    {{/consolidatedStatus}}
                    {{#notes}}
                        <tr>
                            <td colspan="2">Note: {{.}}</td>
                        </tr>
                    {{/notes}}
                    <tr>
                        <td colspan="2">Source: {{sourceEndpointName}}</td>
                    </tr>
                    </tbody>
                </table>
            </div>
        {{/hospitalizationGoalModels}}
    </div>
</div>

<script type="text/javascript">
    function getBasePath() {
        return "/patient/goals";
    }

    function renderModels(models) {
        let container = $('#modelsContainer');
        if (models && models.length > 0) {
            let cards = [];
            let id = 1;
            models.forEach(function(model) {
                cards.push(renderCard('card_' + id, buildCardData(model)));
                id ++;
            });
            container.html(cards.join('\n'));
        }
    }

    function buildCardData(model) {
        return {
            title: model.description,
            rows: [],
            history: null
        };
    }

    $(document).ready(function() {
        if ($('#sessionEstablished').text() !== 'true') {
            return;
        }

        // on page load, get the list of models before SSE triggers
        getUpdatedModels(renderModels);
        initializeSSE();
    });
</script>

{{>layout/footer}}