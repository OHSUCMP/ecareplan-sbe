{{>layout/header}}

<div id="sessionEstablished" class="hidden">{{sessionEstablished}}</div>
<div id="dataSets" class="hidden">{{dataSets}}</div>

<div class="container">
    {{>fragments/system-status-message}}

    <div id="progressContainer" class="hidden"></div>

    <h1>Assessments</h1>
    <div id="modelsContainer">
        <div class="d-flex align-items-center gap-3 p-3 border rounded bg-light text-muted" role="status" aria-live="polite">
            <div class="spinner-border color-primary" aria-hidden="true"></div>
            <div>
                <div class="fw-semibold">Loading records...</div>
                <div class="small">We’re gathering the latest information for this section.</div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function getBasePath() {
        return "/patient/assessments";
    }

    function buildCardSelectorData(model) {
        return [{
            label: 'Name',
            value: model.label,
            bootstrapWidth: 8
        }, {
            label: 'Authored Date',
            value: formatDate(model.authored),
            valueForCompare: model.authored,
            bootstrapWidth: 4
        }];
    }

    function buildCardData(model) {
        let card = {};
        card.title = model.label;
        card.learnMoreUrl = model.learnMoreUrl;

        if (model.responseSummaryList && model.responseSummaryList.length >= 2) {
            let chartData = [];

            model.responseSummaryList.forEach(function(response) {
                let x = response.authored;
                let y = Number(response.score);

                if (x && Number.isFinite(y)) {
                    chartData.push({
                        x: x,
                        y: y
                    });
                }
            });

            if (chartData.length >= 2) {
                card.chart = {};
                card.chart.title = card.title + ' Over Time';
                card.chart.labels = {
                    x: 'Date',
                    y: 'Score'
                };
                card.chart.data = chartData;
            }
        }

        card.rows = [];
        if (model.responseSummaryList && model.responseSummaryList.length > 0) {
            card.rows.push({
                title: 'Historical Data',
                headers: [ 'Authored Date', 'Score', 'Interpretation', 'Source' ],
                rows: model.responseSummaryList.map(function(data) {
                    return [ formatDate(data.authored), data.score, data.interpretation, data.sourceEndpointName ];
                }),
                beginExpanded: true
            });
        }

        return card;
    }

    $(document).ready(function() {
        if ($('#sessionEstablished').text() !== 'true') {
            return;
        }

        getUpdatedModels(renderModels);
        initializeSSE(renderModels);
    });
</script>

{{>layout/footer}}
