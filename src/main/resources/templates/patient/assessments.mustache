{{>layout/header}}

<div id="sessionEstablished" class="hidden">{{sessionEstablished}}</div>
<div id="dataSets" class="hidden">{{dataSets}}</div>

<div class="container">
    {{>fragments/system-status-message}}

    <div id="progressContainer" class="hidden"></div>

    <h1>Assessments</h1>
    <div id="modelsContainer">
        <div class="d-flex align-items-center gap-3 p-3 border rounded bg-light text-muted" role="status" aria-live="polite">
            <div class="spinner-border color-primary" aria-hidden="true"></div>
            <div>
                <div class="fw-semibold">Loading records...</div>
                <div class="small">We’re gathering the latest information for this section.</div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function getBasePath() {
        return "/patient/assessments";
    }

    function buildCardSelectorData(model) {
        model = model || {};
        let mostRecentData = getVisibleSourceRecords(model, 'authored')[0] || {};

        return [{
            label: 'Name',
            value: model.label || '(No Name)',
            bootstrapWidth: 8
        }, {
            label: 'Authored Date',
            value: formatDate(mostRecentData.authored),
            valueForCompare: mostRecentData.authored,
            bootstrapWidth: 4
        }];
    }

    function buildCardData(model) {
        model = model || {};

        let card = {};
        card.title = model.label || '(No Name)';
        card.learnMoreUrl = model.learnMoreUrl;

        let responseSummaryList = getVisibleSourceRecords(model, 'authored');
        card.source = getSourceEndpointNames(responseSummaryList.map(function(response) {
            return response.sourceEndpointName;
        }));

        if (responseSummaryList.length >= 2) {
            let chartData = [];

            responseSummaryList.forEach(function(response) {
                response = response || {};

                let x = response.authored;
                let y = Number(response.score);

                if (x && Number.isFinite(y)) {
                    chartData.push({
                        source: response.sourceEndpointName,
                        x: x,
                        y: y
                    });
                }
            });

            if (chartData.length >= 2) {
                card.chart = {};
                card.chart.title = card.title + ' Over Time';
                card.chart.labels = {
                    x: 'Date',
                    y: 'Score'
                };
                card.chart.data = chartData;
            }
        }

        card.rows = [];
        if (responseSummaryList.length > 0) {
            card.rows.push({
                title: 'Historical Data',
                headers: [ 'Authored Date', 'Score', 'Interpretation' ],
                rows: responseSummaryList.map(function(data) {
                    data = data || {};

                    return {
                        source: data.sourceEndpointName,
                        data: [
                            formatDate(data.authored),
                            data.score === undefined || data.score === null ? '' : data.score,
                            data.interpretation || ''
                        ]
                    };
                }),
                beginExpanded: true
            });
        }

        return card;
    }

    $(document).ready(function() {
        try {
            if ($('#sessionEstablished').text() !== 'true') {
                return;
            }

            getUpdatedModels(renderModels);
            initializeSSE(renderModels);
        } catch (error) {
            reportAndRenderModelsError(error, getBasePath() + ' document ready');
        }
    });
</script>

{{>layout/footer}}
