{{>layout/header}}

<div id="sessionEstablished" class="hidden">{{sessionEstablished}}</div>
<div id="dataSets" class="hidden">{{dataSets}}</div>

<div class="container">
    {{>fragments/system-status-message}}

    <div id="progressContainer" class="hidden"></div>

    <h1>Visits</h1>
    <div id="modelsContainer">
        <div class="d-flex align-items-center gap-3 p-3 border rounded bg-light text-muted" role="status" aria-live="polite">
            <div class="spinner-border color-primary" aria-hidden="true"></div>
            <div>
                <div class="fw-semibold">Loading records...</div>
                <div class="small">We’re gathering the latest information for this section.</div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function getBasePath() {
        return "/patient/visits";
    }

    function buildCardSelectorData(model) {
        model = model || {};

        return [{
            label: 'Description',
            value: model.description || '(No Description)',
            bootstrapWidth: 7
        }, {
            label: 'Date (range)',
            value: model.period || '',
            valueForCompare: model.effectiveDate,
            bootstrapWidth: 5
        }];
    }

    function buildCardData(model) {
        model = model || {};

        let card = {};
        let participants = Array.isArray(model.participants) ? model.participants : [];
        let reasons = Array.isArray(model.reasons) ? model.reasons : [];
        let notes = Array.isArray(model.notes) ? model.notes : [];

        card.title = model.description || '(No Description)';
        card.source = model.sourceEndpointName;
        card.rows = [];

        if (model.serviceType || model.period) {
            card.rows.push([
                { label: 'Type', value: model.serviceType || '' },
                { label: 'Date (range)', value: model.period || '' }
            ]);
        }
        if (participants.length > 0) {
            card.rows.push({
                title: 'Participants',
                headers: [ 'Participant' ],
                rows: participants.map(function(participant) {
                    return [ participant || '' ];
                }),
                beginExpanded: true
            });
        }
        if (reasons.length > 0) {
            card.rows.push({
                title: 'Reasons',
                headers: [ 'Reason' ],
                rows: reasons.map(function(reason) {
                    return [ reason || '' ];
                }),
                beginExpanded: true
            });
        }
        if (notes.length > 0) {
            card.rows.push({
                title: 'Notes',
                headers: [ 'Note' ],
                rows: notes.map(function(note) {
                    return [ note || '' ];
                }),
                beginExpanded: true
            });
        }

        return card;
    }

    $(document).ready(function() {
        try {
            if ($('#sessionEstablished').text() !== 'true') {
                return;
            }

            getUpdatedModels(renderModels);
            initializeSSE(renderModels);
        } catch (error) {
            reportAndRenderModelsError(error, getBasePath() + ' document ready');
        }
    });
</script>

{{>layout/footer}}