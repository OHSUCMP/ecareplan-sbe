{{>layout/header}}

<div id="sessionEstablished" class="hidden">{{sessionEstablished}}</div>

<div class="container">
    {{#systemStatusMessage}}
        <div class="row align-items-center alert alert-teal" role="alert">
            <div class="col-md-auto text-center">
                <img src="/images/info-icon.png" alt="System Status" height="50px" />
            </div>
            <div class="col">
                {{systemStatusMessage}}
            </div>
        </div>
    {{/systemStatusMessage}}

    <h1>Care Team</h1>
    <div class="cardContainer">
        {{#careTeamModels}}
            <div class="card">
                <table>
                    <thead>
                    <tr>
                        <td colspan="2">{{description}}</td>
                    </tr>
                    </thead>
                    <tbody>
                    {{#period}}
                        <tr>
                            <td colspan="2">Time Period: {{period}}</td>
                        </tr>
                    {{/period}}
                    <tr>
                        <td colspan="2">
                            <table>
                                <tbody>
                                {{#participants}}
                                    <tr>
                                        <td>{{name}}</td>
                                        <td>{{#role}}{{role}}{{/role}}</td>
                                        <td>{{#period}}{{period}}{{/period}}</td>
                                    </tr>
                                {{/participants}}
                                </tbody>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2">Source: {{sourceEndpointName}}</td>
                    </tr>
                    </tbody>
                </table>
            </div>
        {{/careTeamModels}}
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function() {
        let sessionEstablished = $('#sessionEstablished').text();
        if (sessionEstablished !== 'true') {
            return;
        }

        // todo : things that should happen once the page has loaded
    });
</script>

{{>layout/footer}}