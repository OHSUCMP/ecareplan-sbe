{{>layout/header}}

<div id="sessionEstablished" class="hidden">{{sessionEstablished}}</div>
<div id="dataSets" class="hidden">{{dataSets}}</div>

<div class="container">
    {{#systemStatusMessage}}
        <div class="row align-items-center alert alert-teal" role="alert">
            <div class="col-md-auto text-center">
                <img src="/images/info-icon.png" alt="System Status" height="50px" />
            </div>
            <div class="col">
                {{systemStatusMessage}}
            </div>
        </div>
    {{/systemStatusMessage}}

    <div id="progressContainer" class="hidden"></div>

    <h1>Care Team</h1>
    <div id="modelsContainer">
        <div class="d-flex align-items-center gap-3 p-3 border rounded bg-light text-muted" role="status" aria-live="polite">
            <div class="spinner-border color-primary" aria-hidden="true"></div>
            <div>
                <div class="fw-semibold">Loading records...</div>
                <div class="small">We’re gathering the latest information for this section.</div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function getBasePath() {
        return "/patient/care-team";
    }

    function buildCardSelectorData(model) {
        return [{
            label: 'Description',
            value: model.description,
            bootstrapWidth: 8
        }, {
            label: 'Source',
            value: model.sourceEndpointName,
            bootstrapWidth: 4
        }];
    }

    function buildCardData(model) {
        let card = {};
        card.title = model.description;
        card.rows = [];
        if (model.name) {
            card.rows.push(['Name: ' + model.name]);
        }
        if (model.category) {
            card.rows.push(['Category: ' + model.category]);
        }
        if (model.period) {
            card.rows.push(['Time Period: ' + model.period]);
        }
        if (model.participants && model.participants.length > 0) {
            card.rows.push({
                title: 'Participants',
                headers: ['Name', 'Role', 'Time Period'],
                rows: model.participants.map(function(participant) {
                    return [participant.name, participant.role ?? null, participant.period ?? null];
                })
            });
        }
        card.rows.push(['Source: ' + model.sourceEndpointName]);
        return card;
    }

    $(document).ready(function() {
        if ($('#sessionEstablished').text() !== 'true') {
            return;
        }

        // on page load, get the list of models before SSE triggers
        getUpdatedModels(renderModels);
        initializeSSE(renderModels);
    });
</script>

{{>layout/footer}}