{{>layout/header}}

<div id="sessionEstablished" class="hidden">{{sessionEstablished}}</div>
<div id="dataSets" class="hidden">{{dataSets}}</div>

<div class="container">
    {{#systemStatusMessage}}
        <div class="row align-items-center alert alert-teal" role="alert">
            <div class="col-md-auto text-center">
                <img src="/images/info-icon.png" alt="System Status" height="50px" />
            </div>
            <div class="col">
                {{systemStatusMessage}}
            </div>
        </div>
    {{/systemStatusMessage}}

    <div id="progressContainer" class="hidden"></div>

    <h1>Immunizations</h1>
    <div id="modelsContainer">
        Loading...
    </div>

    <div class="cardContainer">
        {{#immunizationModels}}
            <div class="card">
                <table>
                    <thead>
                    <tr>
                        <td colspan="2">{{#description}}{{description}}{{/description}}{{^description}}No text{{/description}}</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td colspan="2">Administered on: {{#effectiveDate}}{{effectiveDate}}{{/effectiveDate}}{{^effectiveDate}}Unknown{{/effectiveDate}}</td>
                    </tr>
                    {{#location}}
                        <tr>
                            <td colspan="2">Location: {{location}}</td>
                        </tr>
                    {{/location}}
                    {{#notes}}
                        <tr>
                            <td colspan="2">Notes: {{.}}</td>
                        </tr>
                    {{/notes}}
                    <tr>
                        <td colspan="2">Source: {{sourceEndpointName}}</td>
                    </tr>
                    </tbody>
                </table>
            </div>
        {{/immunizationModels}}
    </div>
</div>

<script type="text/javascript">
    function getBasePath() {
        return "/patient/immunizations";
    }

    function buildCardData(model) {
        return {
            title: model.description,
            rows: [],
            history: null
        };
    }

    $(document).ready(function() {
        if ($('#sessionEstablished').text() !== 'true') {
            return;
        }

        // on page load, get the list of models before SSE triggers
        getUpdatedModels(renderModels);
        initializeSSE(renderModels);
    });
</script>

{{>layout/footer}}