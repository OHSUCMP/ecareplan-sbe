<!DOCTYPE HTML>
<html lang="en">
<head>
	<title>{{applicationName}}</title>
	<meta charset="utf-8">
	<meta name="ctx" content="{{req.contextPath}}/">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    {{>fragments/css}}

	{{! Page-specific stylesheets can be specified in the view model }}
	{{#pageStyles}}
	    <link rel="stylesheet" href="{{req.contextPath}}/css/{{.}}">
	{{/pageStyles}}

    {{>fragments/assets}}

    {{! Webjars needed by page-specific scripts can be specified in the view model }}
    {{#pageWebjars}}
        <script type="text/javascript" src="{{req.contextPath}}/webjars/{{.}}"></script>
    {{/pageWebjars}}

    {{! Page-specific scripts can be specified in the view model }}
    {{#pageScripts}}
        <script type="text/javascript" src="{{req.contextPath}}/js/{{.}}"></script>
    {{/pageScripts}}

    <script type="text/javascript">
        const IDLE_TIMEOUT_SECONDS = Number({{idleTimeoutSeconds}});
        const IDLE_COUNTDOWN_SECONDS = Math.min(60, Math.max(1, IDLE_TIMEOUT_SECONDS));
        const IDLE_COUNTDOWN_APPEAR_SECONDS = Math.max(0, IDLE_TIMEOUT_SECONDS - IDLE_COUNTDOWN_SECONDS);

        function getContextPath() {
            return $('meta[name="ctx"]').attr('content') || '/';
        }

        function buildContextUrl(path) {
            const contextPath = getContextPath().replace(/\/$/, '');
            return contextPath + path;
        }

        function hideProtectedPageContent() {
            $('body').addClass('session-validation-pending');
        }

        function showProtectedPageContent() {
            $('body').removeClass('session-validation-pending');
        }

        function redirectToUnauthorized() {
            hideProtectedPageContent();
            window.location.replace(buildContextUrl("/unauthorized"));
        }

        // adapted from https://stackoverflow.com/questions/667555/how-to-detect-idle-time-in-javascript
        let setupIdleTimeout = function() {
            if (window.idleTimeoutConfigured === true) {
                return;
            }
            window.idleTimeoutConfigured = true;

            let backgroundTimer;
            let timeoutCountdown;
            let timeoutCountdownVisible = false;

            window.addEventListener('load', resetBackgroundTimer);
            window.addEventListener('mousemove', resetBackgroundTimer);
            window.addEventListener('mousedown', resetBackgroundTimer);    // catches touchscreen presses as well
            window.addEventListener('touchstart', resetBackgroundTimer);   // catches touchscreen swipes as well
            window.addEventListener('touchmove', resetBackgroundTimer);    // required by some devices
            window.addEventListener('click', resetBackgroundTimer);        // catches touchpad clicks as well
            window.addEventListener('keydown', resetBackgroundTimer);
            window.addEventListener('scroll', resetBackgroundTimer, true); // improved; see comments
            window.addEventListener('focus', resetBackgroundTimer);

            // adapted from https://www.w3schools.com/howto/howto_js_countdown.asp
            function startTimeoutCountdown(el) {
                let secondsRemaining = IDLE_COUNTDOWN_SECONDS;
                $(el).text(secondsRemaining);

                return setInterval(function() {
                    secondsRemaining -= 1;
                    $(el).text(Math.max(0, secondsRemaining));

                    if (secondsRemaining <= 0) {
                        clearInterval(timeoutCountdown);
                        clearTimeout(backgroundTimer);
                        window.location.replace(buildContextUrl("/inactivity-logout"));
                    }
                }, 1000);
            }

            function showTimeoutCountdown() {
                if (timeoutCountdownVisible) {
                    return;
                }

                timeoutCountdownVisible = true;
                clearInterval(timeoutCountdown);

                $("#timeoutCountdownContainer")
                        .addClass('is-visible')
                        .attr('aria-hidden', 'false');

                timeoutCountdown = startTimeoutCountdown('#timeoutCountdownSeconds');
                $('#continueSession').trigger('focus');
            }

            function hideTimeoutCountdown() {
                timeoutCountdownVisible = false;
                clearInterval(timeoutCountdown);

                $('#timeoutCountdownContainer')
                        .removeClass('is-visible')
                        .attr('aria-hidden', 'true');
            }

            function resetBackgroundTimer() {
                if (timeoutCountdownVisible) {
                    return;
                }

                clearTimeout(backgroundTimer);
                backgroundTimer = setTimeout(showTimeoutCountdown, IDLE_COUNTDOWN_APPEAR_SECONDS * 1000);
            }

            $(document).on('click', '#continueSession', function() {
                hideTimeoutCountdown();
                resetBackgroundTimer();
            });

            $(document).on('keydown', function(event) {
                if (event.key === 'Escape' && timeoutCountdownVisible) {
                    $('#continueSession').trigger('click');
                }
            });

            resetBackgroundTimer();
        };

        let sessionValidationRequest = null;

        function validateSession() {
            if (sessionValidationRequest) {
                return sessionValidationRequest;
            }

            sessionValidationRequest = $.ajax({
                method: "POST",
                url: buildContextUrl("/validate-session"),
                async: true,
                cache: false,
                success: function(result) {
                    if (result === true) {
                        showProtectedPageContent();

                        if (IDLE_TIMEOUT_SECONDS > 0) {
                            setupIdleTimeout();
                        }
                    } else {
                        redirectToUnauthorized();
                    }
                },
                error: function(xhr) {
                    hideProtectedPageContent();

                    if (xhr.status === 401 || xhr.status === 403) {
                        window.location.replace(buildContextUrl("/unauthorized"));
                    } else {
                        window.location.replace(buildContextUrl("/error"));
                    }
                },
                complete: function() {
                    sessionValidationRequest = null;
                }
            });

            return sessionValidationRequest;
        }

        $(document).ready(function() {
            validateSession();
        });

        window.addEventListener('pageshow', function(event) {
            if (event.persisted) {
                hideProtectedPageContent();
            }

            validateSession();
        });
    </script>
</head>
<body>
<div id="timeoutCountdownContainer"
     class="idle-timeout-backdrop"
     role="dialog"
     aria-modal="true"
     aria-hidden="true"
     aria-labelledby="timeoutCountdownTitle"
     aria-describedby="timeoutCountdownDescription">
    <div id="timeoutCountdown" class="idle-timeout-dialog">
        <div class="idle-timeout-icon" aria-hidden="true">
            <span class="fa-solid fa-clock"></span>
        </div>

        <div class="idle-timeout-content">
            <div id="timeoutCountdownTitle" class="idle-timeout-title">Still there?</div>
            <div id="timeoutCountdownDescription" class="idle-timeout-message">
                For your privacy and security, your session will end soon because there has been no recent activity.
            </div>

            <div class="idle-timeout-countdown" aria-live="polite">
                <span class="idle-timeout-countdown-number" id="timeoutCountdownSeconds">60</span>
                <span class="idle-timeout-countdown-label">seconds remaining</span>
            </div>

            <div class="idle-timeout-actions">
                <button id="continueSession" type="button" class="btn button-primary idle-timeout-button">
                    Continue Session
                </button>
            </div>
        </div>
    </div>
</div>

<header class="app-header">
    <nav class="navbar navbar-expand-md navbar-dark fixed-top app-navbar">
        <div class="container-fluid app-navbar-container">
            <a class="navbar-brand app-navbar-brand" href="{{req.contextPath}}/patient" aria-label="{{applicationName}} Home">
                <img src="{{req.contextPath}}/images/logo.png" alt="{{applicationName}}" class="app-navbar-logo">
                <span class="app-navbar-title">{{applicationName}}</span>
            </a>

            <button class="navbar-toggler app-navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbar_collapse" aria-controls="navbar_collapse"
                    role="button" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse app-navbar-collapse" id="navbar_collapse">
                <ul class="navbar-nav me-auto app-navbar-nav">
                    {{#patientContext}}
                        <li class="nav-item dropdown">
                            <a class="nav-link app-nav-link dropdown-toggle" href="#" id="carePlanDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Care Plan
                            </a>
                            <ul class="dropdown-menu app-dropdown-menu" aria-labelledby="carePlanDropdown">
                                <li><a class="dropdown-item app-dropdown-item" href="{{req.contextPath}}/patient/health-goals">Health Goals</a></li>
                                <li><a class="dropdown-item app-dropdown-item" href="{{req.contextPath}}/patient/health-concerns">Health Concerns</a></li>
                                <li><a class="dropdown-item app-dropdown-item" href="{{req.contextPath}}/patient/medications">Medications</a></li>
                                <li><a class="dropdown-item app-dropdown-item" href="{{req.contextPath}}/patient/visits">Visits</a></li>
                                <li><a class="dropdown-item app-dropdown-item" href="{{req.contextPath}}/patient/upcoming-tests-and-procedures">Upcoming Tests and Procedures</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link app-nav-link dropdown-toggle" href="#" id="healthStatusDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Health Status
                            </a>
                            <ul class="dropdown-menu app-dropdown-menu" aria-labelledby="healthStatusDropdown">
                                <li><a class="dropdown-item app-dropdown-item" href="{{req.contextPath}}/patient/lab-results">Lab Results</a></li>
                                <li><a class="dropdown-item app-dropdown-item" href="{{req.contextPath}}/patient/vitals">Vitals</a></li>
                                <li><a class="dropdown-item app-dropdown-item" href="{{req.contextPath}}/patient/assessments">Assessments</a></li>
                                <li><a class="dropdown-item app-dropdown-item" href="{{req.contextPath}}/patient/immunizations">Immunizations</a></li>
                            </ul>
                        </li>
                        <li class="nav-item"><a class="nav-link app-nav-link" href="{{req.contextPath}}/patient/care-team">Care Team</a></li>
                    {{/patientContext}}
                    {{#careTeamContext}}
                    {{/careTeamContext}}
                </ul>
                <ul class="navbar-nav app-navbar-actions">
                    <li class="nav-item">
                        <a id="refresh" href="#" class="nav-link app-nav-link app-nav-action">
                            <span class="fa-solid fa-arrows-rotate me-1" aria-hidden="true"></span>
                            Refresh
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link app-nav-link app-nav-action app-nav-logout" href="{{req.contextPath}}/logout">
                            <span class="fa fa-power-off me-1" aria-hidden="true"></span>
                            Log Out
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>

<main role="main" class="{{#mainClasses}}{{.}}{{/mainClasses}}{{^mainClasses}}container{{/mainClasses}}"></main>