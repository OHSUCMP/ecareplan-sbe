<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{applicationName}} - Completing Handshake</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {{>fragments/css}}

    <link rel="stylesheet" href="{{req.contextPath}}/css/auxiliary.css" />

    <script type="text/javascript" src="{{req.contextPath}}/webjars/jquery/jquery.min.js"></script>

    <!-- SMART on FHIR client library - see: https://docs.smarthealthit.org/client-js/#installation -->
    <script type="text/javascript" src="{{req.contextPath}}/js/fhir-client-v2.6.3.min.js"></script>

    <script type="text/javascript">
        const REDIRECT_URI = "{{redirectUri}}";

        function setResponse(message, isError) {
            $('.response')
                    .toggleClass('alert-danger', isError === true)
                    .toggleClass('alert-info', isError !== true)
                    .html(message);
        }

        function completeHandshake(client) {
            let data = {
                clientId: client.state.clientId,
                serverUrl: client.state.serverUrl,
                bearerToken: client.state.tokenResponse.access_token,
                patientId: client.patient.id,
                userId: client.user.id
            };

//            alert("useful development breakpoint");

            $.ajax({
                method: "POST",
                url: REDIRECT_URI + "/complete-handshake",
                data: data
            }).done(function() {
                // alert("useful debug checkpoint");
                setResponse("Handshake completed. Redirecting to MyCarePlanner...", false);
                window.location.replace(REDIRECT_URI);
            }).fail(function (jqXHR) {
                try {
                    let response = JSON.parse(jqXHR.responseText);
                    setResponse("Error " + jqXHR.status + ": " + (response.message ? response.message : "An error occurred. Try again later or contact study staff."), true);
                } catch (e) {
                    setResponse("Error " + jqXHR.status + ": An error occurred. Try again later or contact study staff.", true);
                }
            });
        }

        // see the following for FHIR API documentation:
        // - https://github.com/smart-on-fhir/client-js/blob/master/dist/build/fhir-client.js
        // - http://docs.smarthealthit.org/client-js/
        // - http://docs.smarthealthit.org/client-js/api.html
        // - http://docs.smarthealthit.org/client-js/client.html
        // - http://docs.smarthealthit.org/client-js/request.html

        $(document).ready(function () {
            FHIR.oauth2.ready()
                    .then(function(client) {
//                    alert("useful development breakpoint");
                        if ( ! {{cacheCredentials}} ) {
                            sessionStorage.clear(); // flush credentials stored here by SMART on FHIR
                        }
                        completeHandshake(client);
                    })
                    .catch(function(error) {
                        console.error(error);
                        setResponse("Unable to complete authorization. Please try again later or contact study staff.", true);
                    });
        });
    </script>
</head>
<body class="aux-page">
<main class="aux-page-shell">
    <section class="card aux-page-card" aria-labelledby="page-title">
        <header class="aux-page-header">
            <h1 id="page-title" class="aux-page-title">{{applicationName}}</h1>
            <p class="aux-page-subtitle">Completing secure authorization.</p>
        </header>

        <div class="aux-page-body text-center">
            <div class="spinner-border aux-page-spinner" role="status" aria-label="Loading"></div>
            <p class="aux-page-message">
                Finalizing your connection...
            </p>
            <div class="response alert alert-info mt-4 mb-0" role="status">
                Completing handshake...
            </div>
            <p class="aux-page-detail mt-3">
                You will be redirected automatically when authorization is complete.
            </p>
        </div>

        <footer class="aux-page-footer">
            Establishing your secure MyCarePlanner session.
        </footer>
    </section>
</main>
</body>
</html>