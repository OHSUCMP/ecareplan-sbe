<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Error</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {{>fragments/css}}

    <link rel="stylesheet" href="{{req.contextPath}}/css/auxiliary.css" />

    <script type="text/javascript" src="{{req.contextPath}}/webjars/jquery/jquery.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function() {
            sessionStorage.clear(); // clear the browser session just in case there's anything there
        });
    </script>
</head>
<body class="aux-page">
<main class="aux-page-shell">
    <section class="card aux-page-card" aria-labelledby="page-title">
        <header class="aux-page-header">
            <h1 id="page-title" class="aux-page-title">Something Went Wrong</h1>
            <p class="aux-page-subtitle">We were unable to complete your request.</p>
        </header>

        <div class="aux-page-body">
            <div class="aux-page-icon" aria-hidden="true">
                <span class="fa-solid fa-triangle-exclamation"></span>
            </div>
            <p class="aux-page-message">
                An unexpected error occurred.
            </p>
            <p class="aux-page-detail">
                Please try again later. If the problem persists, contact support or study staff and include the approximate time this occurred.
            </p>
        </div>

        <footer class="aux-page-footer">
            Technical details may be available in the server logs.
        </footer>
    </section>
</main>
</body>
</html>