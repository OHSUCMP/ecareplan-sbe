<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Logged out</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {{>fragments/css}}

    <link rel="stylesheet" href="{{req.contextPath}}/css/auxiliary.css" />

    <script type="text/javascript" src="{{req.contextPath}}/webjars/jquery/jquery.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function() {
            sessionStorage.clear(); // clear the browser session just in case there's anything there
        });
    </script>
</head>
<body class="aux-page">
<main class="aux-page-shell">
    <section class="card aux-page-card" aria-labelledby="page-title">
        <header class="aux-page-header">
            <h1 id="page-title" class="aux-page-title">You Have Been Logged Out</h1>
            <p class="aux-page-subtitle">Your MyCarePlanner session has ended.</p>
        </header>

        <div class="aux-page-body">
            <div class="aux-page-icon" aria-hidden="true">
                <span class="fa-solid fa-circle-check"></span>
            </div>
            <p class="aux-page-message">
                Logout was successful.
            </p>
            <p class="aux-page-detail">
                Please close this browser window to help ensure all local data is removed and session state is fully cleared.
            </p>

            <div class="aux-page-actions">
                <a class="btn button-primary" href="{{req.contextPath}}/patient/launch">
                    <span class="fa-solid fa-right-to-bracket me-2" aria-hidden="true"></span>
                    Log Back In
                </a>
            </div>
        </div>

        <footer class="aux-page-footer">
            Thank you for using MyCarePlanner.
        </footer>
    </section>
</main>
</body>
</html>